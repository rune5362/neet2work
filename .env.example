# Common
NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:3000
# 같은 네트워크의 다른 기기에서 frontend에 접속할 때는 localhost 대신 개발 PC IP를 사용합니다.
# 예: VITE_API_BASE_URL=http://192.168.0.54:3000

# Backend
PORT=3000
CLIENT_URL=http://localhost:5173
# 여러 frontend origin을 허용할 때는 콤마로 구분합니다.
# 예: CLIENT_URL=http://localhost:5173,http://192.168.0.54:5173

# JWT_SECRET 생성 명령:
# Bash: openssl rand -hex 32
# PowerShell: [System.Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30
# 운영 환경에서 reverse proxy/TLS가 없을 때만 false로 둡니다. 기본값은 운영 HTTPS 요구입니다.
REQUIRE_HTTPS=true

# AI (legacy analyze mock flag)
AI_API_KEY=
AI_MODEL=

# AI Routing
AI_ROUTING_DEFAULT=auto
AI_PROVIDER_ORDER=codex_bridge,gemini,local,fallback
AI_PROVIDER_TIMEOUT_MS=180000

# Codex Bridge
CODEX_BRIDGE_ENABLED=false
CODEX_BRIDGE_COMMAND=codex
CODEX_BRIDGE_MODEL=
CODEX_BRIDGE_REASONING_EFFORT=
CODEX_BRIDGE_PROFILE=

# Gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=120000

# Local AI
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_PROTOCOL=ollama

# Database - Optional
# 각자 개인 개발 DB의 PostgreSQL URL을 사용합니다.
# 예: Supabase, AWS RDS, 로컬 PostgreSQL, Docker PostgreSQL
# 읽기 쉽게 관리하려면 DATABASE_URL에는 비밀번호를 빼고 DATABASE_PASSWORD에만 둡니다.
# 필요하면 아래 형식으로 직접 넣을 수 있습니다.
# 예: DATABASE_URL=postgresql://사용자이름:사용자비밀번호@localhost:5432/DB이름?sslmode=disable
DATABASE_URL=
DATABASE_PASSWORD=
POSTGRES_USER=neet2work
POSTGRES_PASSWORD=neet2work
POSTGRES_DB=neet2work

# 자주쓰는 특수문자 인코딩
# 혹은 powerShell에서 [System.Uri]::EscapeDataString("비밀번호")
# 혹은 powerShell에서 [System.Uri]::EscapeDataString('비밀번호')
#  $등이 포함 될 경우 powerShell에서 다르게 인식 할 수 있음
# @  -> %40
# :  -> %3A
# /  -> %2F
# ?  -> %3F
# #  -> %23
# &  -> %26
# =  -> %3D
# +  -> %2B
# %  -> %25
# 공백 -> %20

# AWS RDS - Optional
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 - Optional
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Oracle Cloud - Optional
ORACLE_CLOUD_REGION=
ORACLE_CLOUD_CONFIG_PATH=

# Figma - Optional
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=
FIGMA_TARGET_NODE_ID=
FIGMA_TARGET_TEXT_LAYER_NAME=
