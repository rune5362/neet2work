model ResumeAnalysis {
  id                 String       @id @default(cuid())
  jobId              String       @map("job_id")
  resumeText         String       @map("resume_text")
  matchScore         Int          @map("match_score")
  strengths          String[]     @default([])
  weaknesses         String[]     @default([])
  missingKeywords    String[]     @default([]) @map("missing_keywords")
  rewriteGuides      String[]     @default([]) @map("rewrite_guides")
  suggestedSentences String[]     @default([]) @map("suggested_sentences")
  mode               AnalysisMode @default(mock)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")
  createdBy          String?      @map("created_by")
  updatedBy          String?      @map("updated_by")
  deletedBy          String?      @map("deleted_by")
  job                JobPosting   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([deletedAt])
  @@index([jobId])
  @@map("resume_analyses")
}
