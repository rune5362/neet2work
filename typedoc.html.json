{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Neet2Work Internal API",
  "entryPoints": ["apps/backend/src", "apps/frontend/src"],
  "entryPointStrategy": "expand",
  "out": "docs/generated/api-html",
  "tsconfig": "typedoc.tsconfig.json",
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/src/test/**",
    "**/src/generated/**",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "readme": "none",
  "skipErrorChecking": true,
  "sort": ["source-order"],
  "navigationLinks": {
    "Repository": "https://github.com/rune5362/neet2work"
  }
}
